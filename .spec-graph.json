{
  "patterns": ["AGENTS.md", "README.md", "docs/**/*.md", "spec/**/*.md"],
  "strict": true,
  "claims": {
    "files": ["spec/**/*.md"],
    "labels": {
      "Exploratory": "open",
      "Decided": "open",
      "Tested": "done",
      "Proved": "done"
    }
  },
  "registers": {
    "files": ["docs/design-review.md"],
    "resolution": "Resolution",
    "statuses": {
      "open": {},
      "proposed": { "needs": ["resolution"] },
      "decided": { "needs": ["resolution"] },
      "done": { "closes": true, "needs": ["citation", "commit"] },
      "superseded": { "closes": true, "needs": ["citation"] }
    }
  },
  "orientation": {
    "files": ["README.md"],
    "extensions": [".md"]
  }
}
